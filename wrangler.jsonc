{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rucdev-blog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}
